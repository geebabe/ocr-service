FROM vllm/vllm-openai:latest

# Cài đặt các thư viện lõi cho Vintern / InternLM
# Dùng python3 -m pip để đảm bảo cài đúng vào môi trường Python của vLLM
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir sentencepiece protobuf tiktoken einops timm torchvision
