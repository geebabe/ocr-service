FROM python:3.10-slim

WORKDIR /app

# Install system dependencies required by opencv, paddlepaddle and healthcheck (curl)
RUN apt-get update && apt-get install -y \
    mupdf mupdf-tools \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY main.py .

# PaddleOCR downloads models on the first run, so the first request might be slow.
# We initialize it in main.py on startup.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
